---
import AppShell from "../../components/AppShell.astro";
import Icon from "../../components/Icon.astro";
import HubTile from "../../components/buyer/HubTile.astro";
import { requestQuota } from "../../lib/ui/requests";
import { referralProgress, REFERRAL_PROGRESS_TARGET } from "../../lib/ui/profile";
import { loadReferralSummary, loadRequests } from "../../lib/convex/dataAdapter";

// Real quota (same source as /app/requests, so the two can't contradict) + real referral
// count from Convex, with mock fallback when Convex isn't configured. The reward bar tracks
// the VERIFIED-friend count (CLAUDE.md). Editing / sign-out / channel persistence and the
// Invite action stay display-only buttons so route-coverage stays green.
const reqView = await loadRequests();
const quota = requestQuota(reqView.activeCount, reqView.quotaTotal);
const referral = referralProgress((await loadReferralSummary()).verifiedCount, REFERRAL_PROGRESS_TARGET);

// Hub tiles. `href` set => a real (resolving) link; otherwise a display-only button.
const buying = [
  { label: "My Requests", icon: "bell", href: "/app/requests" },
  { label: "Saved", icon: "star" },
  { label: "Purchases", icon: "ticket", href: "/app/tickets" },
  { label: "Notifications", icon: "bell" },
];
const selling = [
  { label: "My Listings", icon: "tag", href: "/app/sell" },
  { label: "Orders", icon: "trend", href: "/app/sell/orders" },
  { label: "Payouts", icon: "shield", sub: "Paid after the buyer confirms" },
  { label: "List a ticket", icon: "plus", href: "/app/sell" },
];
const channels = [
  { label: "Email", icon: "mail", on: true },
  { label: "Push", icon: "bell", on: true },
  { label: "Telegram", icon: "signal", soon: true },
  { label: "WhatsApp", icon: "signal", soon: true },
];
---

<AppShell routeId="/app/profile" title="Profile" hideHeader>
  <div class="profhead">
    <span class="avatar">Y</span>
    <div class="pn">
      <b>You<span class="seller-tick"><Icon name="check" />Verified</span></b>
      <span>Buyer &amp; seller</span>
    </div>
    <button type="button" class="ed" aria-label="Edit profile"><Icon name="edit" /></button>
  </div>

  <div class="tier-card metal">
    <div class="tt">
      <div><b>Free plan</b><div class="pl">The success fee is ₹10 + GST per sale.</div></div>
      <a class="up" href="/app/profile/plans"><Icon name="crown" />Compare Plus</a>
    </div>
    <div class="rp"><span>Invite 3 verified friends → earlier alerts</span><span>{referral.label}</span></div>
    <div class="track"><i style={`width:${referral.percent}%`}></i></div>
    <button type="button" class="btn btn-ghost inv"><Icon name="gift" />Invite friends</button>
  </div>

  <div class="quota gl">
    <div class="qtop"><b>{quota.label}</b><span>Free plan</span></div>
    <div class="track"><i style={`width:${quota.percent}%`}></i></div>
    <div class="qsub">Each active request is watched across official and community supply.</div>
  </div>

  <div class="divider">Buying</div>
  <div class="tiles">{buying.map((t) => <HubTile tile={t} />)}</div>

  <div class="divider">Selling</div>
  <div class="tiles">{selling.map((t) => <HubTile tile={t} />)}</div>

  <div class="divider">Notifications</div>
  <div class="gl" style="margin:0 22px;border-radius:var(--r-lg);overflow:hidden">
    {
      channels.map((c) => (
        <div class="chan-row">
          <Icon name={c.icon} />
          <b>{c.label}</b>
          {c.soon ? (
            <span class="chip mut">Soon</span>
          ) : (
            <button type="button" class:list={["toggle", { on: c.on }]} aria-label={`${c.label} notifications`} aria-pressed={c.on ? "true" : "false"}>
              {c.on ? "On" : "Off"}
            </button>
          )}
        </div>
      ))
    }
  </div>

  <div class="divider">More</div>
  <div class="gl" style="margin:0 22px;border-radius:var(--r-lg);overflow:hidden">
    <button type="button" class="ghostlink"><Icon name="help" />Help<span class="arrow"><Icon name="chev" /></span></button>
    <button type="button" class="ghostlink"><Icon name="shield" />Protected-payment policy<span class="arrow"><Icon name="chev" /></span></button>
    <button type="button" class="ghostlink"><Icon name="out" />Sign out</button>
  </div>
</AppShell>
