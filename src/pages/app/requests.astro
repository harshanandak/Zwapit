---
import AppShell from "../../components/AppShell.astro";
import Icon from "../../components/Icon.astro";
import { formatDateTime, formatInr } from "../../components/buyer/format";
import { requestQuota, requestStateMeta } from "../../lib/ui/requests";
import { loadRequests } from "../../lib/convex/dataAdapter";

// Real buyer requests from Convex (wants + catalog item + a real want_matches count),
// mock fallback when Convex isn't configured.
const view = await loadRequests();
const quota = requestQuota(view.activeCount, view.quotaTotal);

// The four alert types a request can arm; lit when present. Armed-alerts + alert wave
// are NOT in the wants schema yet, so they are display-derived here (free tier shows the
// Standard wave; Priority/High are Plus, explained on the Plans screen). matchesThisWeek
// is the real want_matches count from the query.
const ALERT_GLYPHS = [
  { key: "availability", icon: "bell" },
  { key: "discount", icon: "tag" },
  { key: "price-drop", icon: "drop" },
  { key: "last-minute", icon: "bolt" },
];
const DEFAULT_ALERTS = ["availability", "discount"];
const CATEGORY_ICON: Record<string, string> = { event_ticket: "music", movie_ticket: "film", bus_travel: "bus" };
const WAVE = { label: "Standard", cls: "" }; // visual tier only, never a queue number (design.md §8)
---

<AppShell routeId="/app/requests" title="Requests" hideHeader>
  <div class="home-top">
    <div class="wordmark" style="font-size:18px">Your requests</div>
    <a class="city gl" style="gap:7px" href="/app/requests/new"><Icon name="plus" />New</a>
  </div>

  <div class="quota gl">
    <div class="qtop"><b>{quota.label}</b><span>Free plan</span></div>
    <div class="track"><i style={`width:${quota.percent}%`}></i></div>
    <div class="qsub">Alerts run on every active request — official and community.</div>
  </div>

  <div class="seg gl" style="margin-top:14px">
    <button type="button" class="on">Active</button>
    <button type="button">Matched</button>
    <button type="button">Purchased</button>
    <button type="button">Expired</button>
  </div>

  {
    view.requests.map((r) => {
      const meta = requestStateMeta(r.state);
      const icon = CATEGORY_ICON[r.category] ?? "bell";
      const sub = [r.venue, r.startAt ? formatDateTime(r.startAt) : null].filter(Boolean).join(" · ");
      return (
        <article class:list={["reqcard", r.state === "matched" ? "hot" : "solid"]}>
          <div class="rhead">
            <span class="icbx"><Icon name={icon} /></span>
            <div>
              <h5>{r.title}</h5>
              <div class="sub">{sub}</div>
            </div>
            <span class:list={["chip", meta.chip]}>{meta.label}</span>
          </div>

          <div class="reqmeta">
            <div class="b">Up to <b>{formatInr(r.budget)}</b></div>
            <div class="alertglyphs">
              {ALERT_GLYPHS.map((g) => (
                <Icon name={g.icon} class={DEFAULT_ALERTS.includes(g.key) ? "on" : undefined} />
              ))}
            </div>
          </div>

          <div class="matchrow">
            <span class="p"><Icon name="spark" /></span>
            <div class="d">
              {r.matchesThisWeek > 0 ? `${r.matchesThisWeek} matches this week` : "No matches yet — we're watching"}
            </div>
            <span class:list={["wave-pill", WAVE.cls]}>{WAVE.label}</span>
            {r.matchListingId && (
              <a class="buy" href={`/app/listings/${r.matchListingId}`}>Buy with Protection</a>
            )}
          </div>

          <div class="reqactions">
            <button type="button" class="btn btn-ghost"><Icon name="edit" />Edit</button>
            <button type="button" class="btn btn-ghost">Pause</button>
          </div>
        </article>
      );
    })
  }

  <div class="nudge">
    <span class="bdg"><Icon name="gift" /></span>
    <div>
      <b>Invite 3 verified friends → one extra request and earlier alerts.</b>
      <span>Rewards unlock when a friend verifies — not on installs.</span>
    </div>
    <a class="btn btn-ghost" href="/app/profile/plans">See referrals</a>
  </div>
</AppShell>
