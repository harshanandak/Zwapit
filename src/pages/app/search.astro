---
import AppShell from "../../components/AppShell.astro";
import Icon from "../../components/Icon.astro";
import ResaleRowCard from "../../components/buyer/ResaleRowCard.astro";
import { isLiveResale } from "../../lib/ui/resaleListings";
import { resultsLabel } from "../../lib/ui/searchResults";
import { loadCommunityListings, loadOfficialCatalog } from "../../lib/convex/dataAdapter";

// Real results from Convex (mock fallback when not configured): official availability
// from the catalog read-model, community resale (live/waitlist) from getHomeListings.
// Two independent reads — run them in parallel so latency doesn't double on a real backend.
const [official, communityRaw] = await Promise.all([loadOfficialCatalog(), loadCommunityListings()]);
const community = communityRaw.filter(isLiveResale);

// Category tabs + filter chips + the All/Official/Community segment are visual this
// slice; real text search + filtering (and the official "Notify me" arming, which is
// an internal-only mutation) are out of scope here.
const categories = [
  { label: "Movie", icon: "film" },
  { label: "Event", icon: "music" },
  { label: "Bus", icon: "bus" },
  { label: "Voucher", icon: "voucher" },
  { label: "Pass", icon: "pass" },
];
const filters = [
  { label: "Bengaluru", icon: "pin" },
  { label: "Price", icon: "tag" },
  { label: "Date", icon: "clock" },
  { label: "Source", icon: "signal" },
  { label: "More", icon: "filter" },
];

// Results shown = official availability + community resale results.
const resultCount = official.length + community.length;
---

<AppShell routeId="/app/search" title="Search" hideHeader>
  <div class="pbar"><h1>Search</h1></div>

  <div class="searchbar gl live"><Icon name="search" />oppenheimer re-release</div>

  <div class="tabrow">
    {
      categories.map((c, i) => (
        <button type="button" class:list={[{ on: i === 0 }]}>
          <Icon name={c.icon} />
          {c.label}
        </button>
      ))
    }
  </div>

  <div class="fchips">
    {
      filters.map((f, i) => (
        <button type="button" class:list={["fchip", { on: i === 0 }]}>
          <Icon name={f.icon} />
          {f.label}
        </button>
      ))
    }
  </div>

  <div class="seg gl sm" style="margin-top:14px">
    <button type="button" class="on">All</button>
    <button type="button">Official</button>
    <button type="button">Community</button>
  </div>

  <div class="divider">Results · {resultsLabel(resultCount)}</div>

  {/* Official availability — catalog read-model. "Notify me" is display-only (arming an
      availability alert is an internal-only/audited mutation, out of scope here). */}
  {
    official.map((item) => (
      <div class="rowcard solid">
        <span class="mini m2">{item.title.charAt(0)}</span>
        <div class="info">
          <h5>{item.title}</h5>
          <div class="sub">{[item.venueOrDestination, item.subtitle].filter(Boolean).join(" · ")}</div>
          <div class="meta"><span class="chip live"><Icon name="ticket" />Official</span></div>
        </div>
        <div class="right"><span class="notify-btn"><Icon name="bell" />Notify me</span></div>
      </div>
    ))
  }

  {/* Wired community resale results, or the create-a-request empty state when none. */}
  {
    community.length === 0 ? (
      <div class="empty gl" style="border-radius:var(--r-lg)">
        <span class="eic"><Icon name="search" /></span>
        <b>Nothing on resale yet</b>
        <p>We can watch this for you and alert you the moment it appears.</p>
        <a class="btn btn-ghost" href="/app/requests/new">Create a request instead</a>
      </div>
    ) : (
      community.map((item, i) => <ResaleRowCard listing={item} index={i} />)
    )
  }
</AppShell>
