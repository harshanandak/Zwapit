---
import AppShell from "../../../components/AppShell.astro";
import Icon from "../../../components/Icon.astro";
import { formatDateTime, formatInr, transferModeLabel } from "../../../components/buyer/format";
import { discountBadge } from "../../../lib/ui/listingBadges";
import { isLiveResale } from "../../../lib/ui/resaleListings";
import { loadCommunityListings } from "../../../lib/convex/dataAdapter";

// Real resale listings from Convex (getHomeListings), live/waitlist only,
// with a mock fallback when Convex isn't configured.
const listings = (await loadCommunityListings()).filter(isLiveResale);

// Browse section tabs (visual filters; wiring lands with the listings backend).
const sections = [
  { label: "Latest", icon: "clock" },
  { label: "Trending", icon: "trend" },
  { label: "Discounted", icon: "tag" },
  { label: "Ending soon", icon: "zap" },
  { label: "Near me", icon: "pin" },
];
const posterArt = ["p1", "p2", "p3", "p4", "p5"];
---

<AppShell routeId="/app/listings" title="Listings" hideHeader>
  <div class="home-top">
    <div class="wordmark" style="font-size:18px">Community listings</div>
    <a class="city gl" href="/app/search" aria-label="Search listings"><Icon name="search" /></a>
  </div>

  <div class="tabrow">
    {
      sections.map((s, i) => (
        <button type="button" class:list={[{ on: i === 0 }]}>
          <Icon name={s.icon} />
          {s.label}
        </button>
      ))
    }
  </div>

  {/* Featured: live community listings from Convex (getHomeListings), linked into detail. */}
  <div class="carousel">
    {
      listings.map((item, i) => {
        const disc = discountBadge(item);
        return (
          <a class="poster-card solid" href={`/app/listings/${item.id}`}>
            <div class={`poster ${posterArt[i % posterArt.length]}`}>
              <div class="art" />
              <div class="glyph">{item.title.charAt(0)}</div>
              <span class="when">{formatDateTime(item.eventOrTripStartAt)}</span>
            </div>
            <div class="body">
              <h4>{item.title}</h4>
              <div class="venue">{item.venueOrRoute} · Qty {item.quantity}</div>
              <div class="meta">
                {disc ? (
                  <span class="disc"><Icon name="tag" />{disc.percent}% off</span>
                ) : (
                  <span class="seller-price">Seller price</span>
                )}
                <span class="chip mode">{transferModeLabel(item.transferMode)}</span>
              </div>
              <div class="pricerow">
                <div class="price price-d"><small>per ticket</small>{formatInr(item.listingPrice)}</div>
                <span class="go"><Icon name="chev" /></span>
              </div>
            </div>
          </a>
        );
      })
    }
  </div>

  {listings.length === 0 && (
    <div class="empty gl" style="border-radius:var(--r-lg)">
      <span class="eic"><Icon name="search" /></span>
      <b>No live listings yet</b>
      <p>We can watch this for you and alert you the moment one appears.</p>
      <a class="btn btn-ghost" style="color:var(--acc)" href="/app/requests">Create a request</a>
    </div>
  )}

</AppShell>
