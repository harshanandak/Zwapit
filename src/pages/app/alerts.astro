---
import AppShell from "../../components/AppShell.astro";
import Icon from "../../components/Icon.astro";
import { formatInr, transferModeLabel } from "../../components/buyer/format";
import { discountBadge } from "../../lib/ui/listingBadges";
import { loadAlerts } from "../../lib/convex/dataAdapter";

// "Alert payoff / Match" (spec §5) — the bell's inbox where a request pays off.
// Only the community MATCH card is backed by real data: the buyer's want_match -> live
// listing (loadAlerts -> getAlertsForBuyer). The official-availability card and the
// "Earlier" feed below stay illustrative — notifications, availability watching, and the
// shared watcher are internal-only/audited and deferred (CLAUDE.md), so there is no real
// source for them yet. Discount-integrity applies: real listings carry no verified original
// price, so the match shows "Seller price", never a fabricated discount.
const view = await loadAlerts();
const earlier = [
  { icon: "ticket", text: "Interstellar (re-release) · PVR Forum — official booking opened. 2 days ago" },
  { icon: "spark", text: "Coldplay · Mumbai — a match you purchased with protection. 4 days ago" },
  { icon: "tag", text: "Oppenheimer 70mm · Bengaluru — price dropped to ₹520. 6 days ago" },
];
---

<AppShell routeId="/app/alerts" title="Alerts" hideHeader>
  <div class="pbar">
    <a class="bk" href="/app/home" aria-label="Back to home"><Icon name="back" /></a>
    <h1>Alerts</h1>
  </div>

  <div class="divider">Just now</div>

  <!-- Official availability alert: deep-links OUT to official booking (Zwapit never
       resells official inventory or touches that money). The per-event deep-link is
       a mock placeholder here — the real one is supplied by the internal availability
       watcher (out of scope); we keep a real official-site URL rather than fabricate
       an unverified event URL that could dead-link. -->
  <div class="alert-card official">
    <div class="rail"></div>
    <div class="ac-body">
      <div class="ac-top">
        <span class="ac-ic"><Icon name="ticket" /></span>
        <h4>Tickets are live!</h4>
        <span class="chip live">Official</span>
      </div>
      <p class="sub">Dune · PVR Orion · Sat 21 Jun, 9:30 PM — official booking just opened.</p>
      <p class="sub" style="margin-top:6px">You + 124 others were alerted. Acting early helps — it's never a guaranteed seat.</p>
      <div class="ac-foot">
        <span class="ac-cta">
          <a
            class="btn"
            href="https://in.bookmyshow.com/"
            target="_blank"
            rel="noopener noreferrer"
            style="background:var(--gold-soft);color:var(--gold);border:1px solid rgba(217,168,78,.4)"
          >Open booking<Icon name="arrow" /></a>
        </span>
      </div>
    </div>
  </div>

  <!-- Community resale match(es): Zwapit transacts here via protected payment. Backed by the
       buyer's real want_match -> live listing. "Buy with Protection" links to the listing detail
       (protection -> checkout) — the param-driven, prerendered route; the checkout route itself
       only prerenders the fixture. Discount-integrity: discountBadge is null for real listings
       (no verified original price), so we show "Seller price". -->
  {
    view.matches.map((m) => {
      const disc = discountBadge({ listingPrice: m.price });
      return (
        <div class="alert-card community">
          <div class="rail"></div>
          <div class="ac-body">
            <div class="ac-top">
              <span class="ac-ic"><Icon name="spark" /></span>
              <h4>A match for your request</h4>
              <span class="chip protect"><Icon name="shield" />Protected payment</span>
            </div>
            <p class="sub">{m.title} · {m.venue} · from a verified seller.</p>
            <div class="ac-foot" style="flex-wrap:wrap">
              <span class="pr">{formatInr(m.price)}</span>
              {disc ? (
                <span class="disc"><Icon name="tag" />{disc.percent}% off</span>
              ) : (
                <span class="seller-price">Seller price</span>
              )}
              <span class="chip mode">{transferModeLabel(m.transferMode)}</span>
            </div>
            <a class="btn btn-primary sweep" href={`/app/listings/${m.listingKey}`} style="width:100%;margin-top:12px">Buy with Protection</a>
          </div>
        </div>
      );
    })
  }

  <div class="trust-band">
    <span class="bdg"><Icon name="shield" size="l" /></span>
    <div>
      <b>Protected payment</b>
      <span>Your payment is held safely until the transfer is confirmed.</span>
    </div>
  </div>

  <div class="divider">Earlier</div>
  <div class="solid" style="margin:0 22px;border-radius:var(--r-lg);overflow:hidden">
    {
      earlier.map((e) => (
        <div class="matchrow">
          <span class="p"><Icon name={e.icon} /></span>
          <div class="d">{e.text}</div>
        </div>
      ))
    }
  </div>
</AppShell>
