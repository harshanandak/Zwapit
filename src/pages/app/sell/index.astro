---
import AppShell from "../../../components/AppShell.astro";
import Icon from "../../../components/Icon.astro";
import {
  buildSellerDraftFromListing,
  formatDateTime,
  formatInr,
  sellerDraftJsonScriptContent,
} from "../../../components/seller/format";
import { createMockFixture } from "../../../lib/mock/fixtures";

// Upload-first single screen (spec §8). The detected draft is mocked (no real
// upload/OCR this slice); the seller sets a price and publishes from one screen.
const { listing } = createMockFixture();
const detectedDraft = buildSellerDraftFromListing(listing);
const detectedDraftJson = sellerDraftJsonScriptContent(detectedDraft);
const price = listing.listingPrice; // seller payout = listing price (buyer pays the fee on top)

const steps = ["Upload", "Details", "Price", "Review"];
const formats = ["PDF", "PNG", "JPG"];
const eligibility = [
  { label: "Movies", icon: "film", ok: true },
  { label: "Events", icon: "music", ok: true },
  { label: "Bus", icon: "bus", ok: true },
  { label: "Vouchers", icon: "voucher", ok: true },
  { label: "Passes", icon: "pass", ok: true },
  { label: "ID-locked", icon: "x", ok: false },
];
---

<AppShell routeId="/app/sell" title="List a ticket" hideHeader>
  <div class="pbar"><h1>List a ticket</h1></div>

  <div class="sell-steps">
    {
      steps.map((s, i) => (
        <>
          <span class:list={["sstep", { on: i === 0 }]}>{s}</span>
          {i < steps.length - 1 && <span class="sep">→</span>}
        </>
      ))
    }
  </div>

  <div class="dropzone">
    <span class="up"><Icon name="upload" size="l" /></span>
    <h4>Upload your ticket</h4>
    <p>Drop a screenshot or PDF — we'll read the details.</p>
    <div class="formats">{formats.map((f) => <span class="fmt">{f}</span>)}</div>
  </div>

  <div class="buyerwait">
    <span class="bdg"><Icon name="people" size="l" /></span>
    <div>
      <b>52 people looking · High interest</b>
      <span>We never share buyer details or budgets.</span>
    </div>
  </div>

  <div class="divider">Detected details</div>
  <div class="catres sel gl">
    <span class="icbx"><Icon name="music" /></span>
    <div class="tx">
      <b>{listing.title}</b>
      <span class="s">{listing.venueOrRoute} · {formatDateTime(listing.eventOrTripStartAt)}</span>
    </div>
    <span class="srcb">BMS</span>
  </div>

  <div class="divider">Your price</div>
  <div class="gl" style="margin:0 22px;border-radius:var(--r-lg);overflow:hidden">
    <div class="formrow">
      <div class="lbl">Your price</div>
      <div class="val">
        <div class="stepper">
          <button type="button" id="price-dec" aria-label="Lower price"><Icon name="minus" /></button>
          <b id="price-val">{formatInr(price)}</b>
          <button type="button" id="price-inc" aria-label="Raise price"><Icon name="plus" /></button>
        </div>
      </div>
    </div>
    <div class="formrow">
      <div class="lbl">Original price <small>Verify to show a discount badge.</small></div>
      <div class="val val-faint">Optional</div>
    </div>
    <div class="formrow">
      <div class="lbl">Discount</div>
      <div class="val val-faint">Seller price</div>
    </div>
    <div class="formrow">
      <div class="lbl">Mark as urgent <small>Adds an "Ending soon" badge.</small></div>
      <div class="val"><button type="button" class="toggle" data-toggle aria-label="Mark as urgent" aria-pressed="false">Off</button></div>
    </div>
    <div class="formrow">
      <div class="lbl">Payout <small>Paid after the buyer confirms.</small></div>
      <div class="val" id="payout-val">{formatInr(price)}</div>
    </div>
  </div>

  <div class="drop-sched gl">
    <div class="ds-top">
      <b>Auto price-drop</b>
      <button type="button" class="toggle" data-toggle aria-label="Auto price-drop" aria-pressed="false">Off</button>
    </div>
    <div class="note">Optional. Example: ₹390 now → ₹360 at 6:30 → ₹330 at 7:00, stopping at start.</div>
  </div>

  <div class="divider">What you can list</div>
  <div class="tiles">
    {
      eligibility.map((e) => (
        <div class:list={["tile", "gl", { no: !e.ok }]}>
          <span class="icbx"><Icon name={e.ok ? "check" : "x"} /></span>
          <b>{e.label}</b>
          <span class:list={["st", e.ok ? "ok" : "no"]}>{e.ok ? "Can list" : "Cannot List"}</span>
        </div>
      ))
    }
  </div>

  <a class="order-metal" href="/app/sell/orders">
    <span class="led"></span>
    <div>
      <b>Your orders</b>
      <span>See orders, transfers, and payouts.</span>
    </div>
    <span class="arrow"><Icon name="chev" /></span>
  </a>

  <div class="divider">Ready to publish</div>
  <label class="reqcard solid" style="display:flex;gap:11px;padding:14px 16px;align-items:flex-start">
    <input type="checkbox" data-seller-promise style="margin-top:3px;accent-color:var(--acc)" />
    <span style="font-size:12px;color:var(--dim);line-height:1.5">
      I'll transfer the ticket before the deadline, it's genuine and unused, and I understand my
      payout is released only after the buyer confirms.
    </span>
  </label>

  <div style="padding:14px 22px 0">
    <a id="promise-continue" href="/app/sell/orders" class="btn btn-primary" style="width:100%">
      Publish listing
    </a>
    <p id="promise-warning" style="margin-top:10px;text-align:center;font-size:11.5px;font-weight:600;color:var(--red)"></p>
    <section id="promise-result" class="catres gl" style="margin:12px 0 0" data-tone="" hidden>
      <div class="tx">
        <b id="promise-result-title"></b>
        <span class="s" id="promise-result-detail"></span>
      </div>
    </section>
    <p style="margin-top:10px;text-align:center;font-size:10.5px;color:var(--faint)">
      Mock flow for this slice — publishing goes live instantly here.
    </p>
  </div>

  <script type="application/json" id="seller-detected-draft" is:inline set:html={detectedDraftJson}></script>
</AppShell>

<script>
  import {
    accountStepUrl,
    gateProtectedActionLink,
    submitSellerListingDraft,
  } from "../../../lib/convex/dataAdapter";
  import {
    formatInr,
    SELLER_DRAFT_STORAGE_KEY,
    SELLER_PUBLISHED_STORAGE_KEY,
    sellerSubmissionView,
    type SellerSubmissionView,
  } from "../../../components/seller/format";
  import type { SellerListingDraft } from "../../../lib/types";

  const continueLink = document.getElementById("promise-continue") as HTMLAnchorElement | null;
  const warning = document.getElementById("promise-warning");
  const resultPanel = document.getElementById("promise-result");
  const resultTitle = document.getElementById("promise-result-title");
  const resultDetail = document.getElementById("promise-result-detail");
  const priceVal = document.getElementById("price-val");
  const payoutVal = document.getElementById("payout-val");

  // Detected (mock) draft is the base; the price stepper edits it in place.
  function readBaseDraft(): SellerListingDraft | null {
    try {
      const stored = sessionStorage.getItem(SELLER_DRAFT_STORAGE_KEY);
      if (stored) return JSON.parse(stored) as SellerListingDraft;
    } catch {
      // fall through to the embedded draft
    }
    try {
      const node = document.getElementById("seller-detected-draft");
      return node?.textContent ? (JSON.parse(node.textContent) as SellerListingDraft) : null;
    } catch {
      return null;
    }
  }

  const base = readBaseDraft();
  // Guard against a malformed/non-finite stored price so NaN never leaks into the
  // display, the persisted draft, or the submission payload.
  const initialPrice = Number(base?.listingPrice);
  let currentPrice = Number.isFinite(initialPrice) && initialPrice > 0 ? Math.floor(initialPrice) : 0;

  function renderPrice(): void {
    if (priceVal) priceVal.textContent = formatInr(currentPrice);
    if (payoutVal) payoutVal.textContent = formatInr(currentPrice);
  }

  function persistPrice(): void {
    if (!base) return;
    try {
      sessionStorage.setItem(
        SELLER_DRAFT_STORAGE_KEY,
        JSON.stringify({ ...base, listingPrice: currentPrice }),
      );
    } catch {
      // best-effort; publish recomputes from currentPrice regardless
    }
  }

  function step(delta: number): void {
    currentPrice = Math.max(50, currentPrice + delta);
    renderPrice();
    persistPrice();
  }

  document.getElementById("price-dec")?.addEventListener("click", () => step(-50));
  document.getElementById("price-inc")?.addEventListener("click", () => step(50));

  // Display-only toggles (urgent / auto price-drop) — no wired scheduling this slice.
  document.querySelectorAll<HTMLButtonElement>("[data-toggle]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const on = btn.classList.toggle("on");
      btn.textContent = on ? "On" : "Off";
      btn.setAttribute("aria-pressed", String(on));
    });
  });

  function showResult(view: SellerSubmissionView): void {
    if (warning) warning.textContent = "";
    if (resultTitle) resultTitle.textContent = view.title;
    if (resultDetail) resultDetail.textContent = view.detail;
    if (resultPanel) {
      resultPanel.dataset.tone = view.tone;
      resultPanel.hidden = false;
    }
  }

  const RETRY_VIEW: SellerSubmissionView = {
    kind: "retry",
    tone: "error",
    title: "Couldn't publish yet",
    detail: "We couldn't save your listing just now. Please try again.",
    ctaLabel: "Try again",
    proceedToOrders: false,
  };

  // Protected publish: a signed-out / phone-unverified seller is routed to the
  // account/verify step before publishing. Verified/demo sellers keep the
  // seller-promise gate and submit through the adapter helper.
  let phoneGateResolved = false;
  let phoneGated = true;
  let submitting = false;
  let navigateAway = false;

  void gateProtectedActionLink("#promise-continue")
    .then((status) => {
      phoneGateResolved = true;
      phoneGated = status !== "verified";
    })
    .catch(() => {
      // Gate failed to resolve: fail closed (treat as gated, so we never submit
      // unverified) but still unblock the CTA so it isn't stuck "Checking…".
      phoneGateResolved = true;
      phoneGated = true;
    });

  async function publish(): Promise<void> {
    if (!base) {
      showResult(RETRY_VIEW);
      submitting = false;
      if (continueLink) continueLink.textContent = RETRY_VIEW.ctaLabel;
      return;
    }

    const draft: SellerListingDraft = {
      ...base,
      listingPrice: currentPrice,
      sellerPromiseAccepted: true,
    };
    if (continueLink) continueLink.textContent = "Publishing…";

    let view: SellerSubmissionView;
    try {
      view = sellerSubmissionView(await submitSellerListingDraft(draft));
    } catch {
      view = RETRY_VIEW;
    }
    showResult(view);

    if (view.kind === "signed_out" || view.kind === "phone_required") {
      window.location.href = accountStepUrl(`${window.location.pathname}${window.location.search}`);
      return;
    }
    if (view.proceedToOrders) {
      try {
        sessionStorage.setItem(
          SELLER_PUBLISHED_STORAGE_KEY,
          JSON.stringify({ kind: view.kind, title: view.title, detail: view.detail }),
        );
      } catch {
        // Banner on Orders is best-effort; the listing is already submitted.
      }
      if (continueLink) continueLink.textContent = view.ctaLabel;
      window.location.href = "/app/sell/orders";
      return;
    }

    // Stay on the page for cannot-list / retry outcomes.
    submitting = false;
    if (continueLink) continueLink.textContent = view.ctaLabel;
    if (view.kind === "cannot_list") {
      continueLink?.setAttribute("href", "/app/sell");
      navigateAway = true;
    } else {
      navigateAway = false;
    }
  }

  renderPrice();

  continueLink?.addEventListener("click", (event) => {
    if (!phoneGateResolved) {
      event.preventDefault();
      if (warning) warning.textContent = "Checking phone verification...";
      return;
    }
    if (phoneGated) return; // gate already points this link at the account/verify step
    if (navigateAway) return; // outcome set an explicit destination — let the link navigate

    // Verified/demo seller: we own the submit, so stop navigation BEFORE awaiting.
    event.preventDefault();
    if (submitting) return;

    const promises = Array.from(document.querySelectorAll<HTMLInputElement>("[data-seller-promise]"));
    const allAccepted = promises.length > 0 && promises.every((promise) => promise.checked);
    if (!allAccepted) {
      if (warning) warning.textContent = "Accept the seller promise to continue.";
      return;
    }

    submitting = true;
    void publish();
  });
</script>
