---
import AppLayout from "../layouts/AppLayout.astro";
import BottomNav from "./BottomNav.astro";
import { resolveNav } from "../lib/ui/navMap";

interface Props {
  /** The `/app/...` route id; drives the ambient accent + active tab. */
  routeId: string;
  /** Document title; also rendered as the page heading unless `hideHeader`. */
  title: string;
  /**
   * Hide the generic title header. The v5 screens render their own top bar
   * (.home-top / .pbar / .hero) and pass `hideHeader`; the transitional existing
   * pages rely on this header for their on-screen heading.
   */
  hideHeader?: boolean;
  /**
   * Legacy 4-tab hint from the old nav. NOT read at runtime — declared only so
   * `astro check` accepts the existing pages that still pass `activeTab=...`.
   * The active tab and ambient accent are derived from `routeId`. Drop once
   * every page has migrated to the v5 screens (U1-U7).
   */
  activeTab?: string;
}

const { routeId, title, hideHeader = false } = Astro.props;
const { tab, accent, showFab } = resolveNav(routeId);
---

<AppLayout title={`${title} | Zwapit`}>
  <div class="app-shell" data-route-id={routeId} style={`--acc:${accent}`}>
    {
      !hideHeader && (
        <header class="pbar">
          <h1>{title}</h1>
        </header>
      )
    }
    <slot />
    <div class="spacer-nav"></div>
    <BottomNav tab={tab} showFab={showFab} />
  </div>
</AppLayout>
