---
import Icon from "./Icon.astro";
import { TABS, type TabKey } from "../lib/ui/navMap";

interface Props {
  /** Active tab to highlight (derived from routeId by AppShell). */
  tab?: TabKey | null;
  /** Show the "List a ticket" FAB (Sell is a FAB, not a tab). */
  showFab?: boolean;
  /**
   * @deprecated Legacy 4-tab prop ("home" | "sell" | "tickets" | "me").
   * Accepted for backward-compatibility but ignored — AppShell drives `tab`
   * from the routeId. Remove once all callers pass `tab`.
   */
  activeTab?: string;
}

const { tab = null, showFab = false } = Astro.props;
const SELL_HREF = "/app/sell";
---

<nav class="bnav" aria-label="Primary">
  {
    TABS.map((t) => (
      <a
        href={t.href}
        class:list={[{ on: t.key === tab }]}
        aria-current={t.key === tab ? "page" : undefined}
      >
        <Icon name={t.icon} />
        {t.label}
      </a>
    ))
  }
</nav>
{
  showFab && (
    <a class="fab" href={SELL_HREF} aria-label="List a ticket">
      <Icon name="plus" />
      List a ticket
    </a>
  )
}
