From 1faae4bcd0e985b7c6dedf88f699ce847e3ca75e Mon Sep 17 00:00:00 2001
From: Harsha Nanda <harshanandak@users.noreply.github.com>
Date: Tue, 16 Jun 2026 16:15:25 +0530
Subject: [PATCH] feat(f1): rebuild AppShell with per-route ambient accent (T7)

resolveNav(routeId) drives --acc on the .app-shell glow root, the active
tab, and FAB visibility; BottomNav now receives tab/showFab. activeTab kept
as an ignored back-compat prop so the 12 existing pages compile untouched.

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
---
 src/components/AppShell.astro | 29 +++++++++++++++++------------
 1 file changed, 17 insertions(+), 12 deletions(-)

diff --git a/src/components/AppShell.astro b/src/components/AppShell.astro
index c702078..c1979f8 100644
--- a/src/components/AppShell.astro
+++ b/src/components/AppShell.astro
@@ -1,25 +1,30 @@
 ---
 import AppLayout from "../layouts/AppLayout.astro";
 import BottomNav from "./BottomNav.astro";
+import { resolveNav } from "../lib/ui/navMap";
 
 interface Props {
-  activeTab?: "home" | "sell" | "tickets" | "me";
+  /** The `/app/...` route id; drives the ambient accent + active tab. */
   routeId: string;
+  /** Document title (shown in the browser tab). */
   title: string;
+  /**
+   * Legacy 4-tab hint ("home" | "sell" | "tickets" | "me"), accepted for
+   * backward-compatibility with the existing pages but ignored — the active
+   * tab and ambient accent are derived from `routeId`. Falls away as each page
+   * migrates to the v5 screens (U1-U7).
+   */
+  activeTab?: string;
 }
 
-const { activeTab, routeId, title } = Astro.props;
+const { routeId, title } = Astro.props;
+const { tab, accent, showFab } = resolveNav(routeId);
 ---
 
 <AppLayout title={`${title} | Zwapit`}>
-  <main data-route-id={routeId} class="mx-auto min-h-dvh max-w-md bg-background px-5 pb-28 pt-6 text-foreground">
-    <header class="mb-6">
-      <p class="text-xs font-semibold uppercase tracking-wide text-primary">Zwapit</p>
-      <h1 class="mt-2 text-2xl font-semibold tracking-normal text-foreground">{title}</h1>
-    </header>
-    <div>
-      <slot />
-    </div>
-  </main>
-  <BottomNav activeTab={activeTab} />
+  <div class="app-shell" data-route-id={routeId} style={`--acc:${accent}`}>
+    <slot />
+    <div class="spacer-nav"></div>
+    <BottomNav tab={tab} showFab={showFab} />
+  </div>
 </AppLayout>
-- 
2.51.0.windows.1

