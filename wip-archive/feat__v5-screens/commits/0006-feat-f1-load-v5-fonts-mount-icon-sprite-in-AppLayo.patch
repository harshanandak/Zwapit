From 93d05696aa5e1feb8ccb2131aeb919301edce467 Mon Sep 17 00:00:00 2001
From: Harsha Nanda <harshanandak@users.noreply.github.com>
Date: Tue, 16 Jun 2026 16:09:27 +0530
Subject: [PATCH] feat(f1): load v5 fonts + mount icon sprite in AppLayout (T5)

Swap Poppins -> Fraunces + Space Grotesk (bundled @fontsource), mount
IconSprite once in <body>, repoint --font-sans to Space Grotesk, remove
@fontsource/poppins. Every commit stays green.

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
---
 bun.lock                    |  3 ---
 package.json                |  1 -
 src/layouts/AppLayout.astro | 17 +++++++++++++----
 src/styles/global.css       |  4 ++--
 4 files changed, 15 insertions(+), 10 deletions(-)

diff --git a/bun.lock b/bun.lock
index b099929..a13540c 100644
--- a/bun.lock
+++ b/bun.lock
@@ -10,7 +10,6 @@
         "@capacitor/core": "7.6.6",
         "@capacitor/ios": "7.6.6",
         "@fontsource/fraunces": "^5.2.9",
-        "@fontsource/poppins": "^5.2.7",
         "@fontsource/space-grotesk": "^5.2.10",
         "@tailwindcss/postcss": "^4.1.17",
         "astro": "^6.3.1",
@@ -201,8 +200,6 @@
 
     "@fontsource/fraunces": ["@fontsource/fraunces@5.2.9", "", {}, "sha512-XDzuddBtoC7BZgZdBn6b7hsFZY2+V1hgN7yca5fBTKuHjb/lOd45a0Ji8dTUgFhPoL7RdGupo+bC2BFSt6UH8Q=="],
 
-    "@fontsource/poppins": ["@fontsource/poppins@5.2.7", "", {}, "sha512-6uQyPmseo4FgI97WIhA4yWRlNaoLk4vSDK/PyRwdqqZb5zAEuc+Kunt8JTMcsHYUEGYBtN15SNkMajMdqUSUmg=="],
-
     "@fontsource/space-grotesk": ["@fontsource/space-grotesk@5.2.10", "", {}, "sha512-XNXEbT74OIITPqw2H6HXwPDp85fy43uxfBwFR5PU+9sLnjuLj12KlhVM9nZVN6q6dlKjkuN8JisW/OBxwxgUew=="],
 
     "@img/colour": ["@img/colour@1.1.0", "", {}, "sha512-Td76q7j57o/tLVdgS746cYARfSyxk8iEfRxewL9h4OMzYhbW4TAcppl0mT4eyqXddh6L/jwoM75mo7ixa/pCeQ=="],
diff --git a/package.json b/package.json
index 8b46a7a..3ead9da 100644
--- a/package.json
+++ b/package.json
@@ -25,7 +25,6 @@
     "@capacitor/core": "7.6.6",
     "@capacitor/ios": "7.6.6",
     "@fontsource/fraunces": "^5.2.9",
-    "@fontsource/poppins": "^5.2.7",
     "@fontsource/space-grotesk": "^5.2.10",
     "@tailwindcss/postcss": "^4.1.17",
     "astro": "^6.3.1",
diff --git a/src/layouts/AppLayout.astro b/src/layouts/AppLayout.astro
index 0769b18..29ba3a1 100644
--- a/src/layouts/AppLayout.astro
+++ b/src/layouts/AppLayout.astro
@@ -1,10 +1,18 @@
 ---
-import "@fontsource/poppins/400.css";
-import "@fontsource/poppins/500.css";
-import "@fontsource/poppins/600.css";
-import "@fontsource/poppins/700.css";
+import "@fontsource/fraunces/400.css";
+import "@fontsource/fraunces/500.css";
+import "@fontsource/fraunces/600.css";
+import "@fontsource/fraunces/400-italic.css";
+import "@fontsource/fraunces/500-italic.css";
+import "@fontsource/fraunces/600-italic.css";
+import "@fontsource/space-grotesk/400.css";
+import "@fontsource/space-grotesk/500.css";
+import "@fontsource/space-grotesk/600.css";
+import "@fontsource/space-grotesk/700.css";
 import "../styles/global.css";
 
+import IconSprite from "../components/IconSprite.astro";
+
 interface Props {
   title?: string;
 }
@@ -22,6 +30,7 @@ const { title = "Zwapit" } = Astro.props;
     <title>{title}</title>
   </head>
   <body>
+    <IconSprite />
     <slot />
   </body>
 </html>
diff --git a/src/styles/global.css b/src/styles/global.css
index 3286803..776503f 100644
--- a/src/styles/global.css
+++ b/src/styles/global.css
@@ -35,7 +35,7 @@
   --sidebar-accent-foreground: oklch(0.3211 0 0);
   --sidebar-border: oklch(0.9529 0.0294 344.7972);
   --sidebar-ring: oklch(0.7559 0.1373 63.5013);
-  --font-sans: Poppins, sans-serif;
+  --font-sans: "Space Grotesk", sans-serif;
   --font-serif: Source Serif 4, ui-serif, serif;
   --font-mono: Fira Code, monospace;
   --radius: 0.4rem;
@@ -91,7 +91,7 @@
   --sidebar-accent-foreground: oklch(0.2677 0.0473 310.2513);
   --sidebar-border: oklch(0.3650 0.0483 312.0204);
   --sidebar-ring: oklch(0.7559 0.1373 63.5013);
-  --font-sans: Poppins, sans-serif;
+  --font-sans: "Space Grotesk", sans-serif;
   --font-serif: Source Serif 4, ui-serif, serif;
   --font-mono: Fira Code, monospace;
   --radius: 0.4rem;
