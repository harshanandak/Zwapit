+    "${open_json:-[]}" \
+    "${in_progress_json:-[]}" \
+    "$(printf '%s' "$task_file" | jq -R '.')" \
+    "$(printf '%s' "$repository_root" | jq -R '.')" \
+    | "$NODE_CMD" "$(node_script_path "$analyzer_script")" --stdin
+}
