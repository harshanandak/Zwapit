+extract_task_file_from_design() {
+  local design_text="$1"
+
+  if [[ -z "$design_text" || "$design_text" != *"|"* ]]; then
+    return 1
+  fi
+
+  local task_file="${design_text#*|}"
+  task_file="$(printf '%s' "$task_file" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
+  [[ -n "$task_file" ]] || return 1
+  printf '%s' "$task_file"
+}
