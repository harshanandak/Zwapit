{
  "name": "zwapit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "check": "astro check",
    "check:routes": "bun scripts/route-coverage.mjs",
    "cap:sync": "bun run build && cap sync",
    "cap:doctor": "cap doctor",
    "android:sync": "bun run build && cap sync android",
    "android:build:debug": "bun run android:sync && bun scripts/build-android-debug.mjs",
    "android:test:debug": "bun run android:sync && bun scripts/test-android-debug.mjs",
    "ios:sync": "bun run build && cap sync ios",
    "ios:build:sim": "bun run ios:sync && bun scripts/build-ios-simulator.mjs",
    "cf:deploy": "bun run build && wrangler deploy",
    "cf:preview": "bun run build && wrangler versions upload",
    "cf:dry-run": "bun run build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@astrojs/react": "^4.4.2",
    "@capacitor/android": "7.6.6",
    "@capacitor/core": "7.6.6",
    "@capacitor/ios": "7.6.6",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "astro": "^6.4.8",
    "convex": "^1.44.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/ts-plugin": "^1.10.10",
    "@capacitor/cli": "7.6.6",
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "convex-test": "^0.0.53",
    "lefthook": "^2.1.10",
    "typescript": "^5.9.3",
    "wrangler": "^4.123.0"
  },
  "overrides": {
    "ws": "8.21.3",
    "yaml-language-server": "1.24.0",
    "tar": "7.5.22",
    "vite": "7.3.5",
    "esbuild": "0.28.1",
    "js-yaml": "4.3.1",
    "sharp": "0.35.2",
    "postcss": "8.5.26",
    "svgo": "4.0.2",
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.5"
  }
